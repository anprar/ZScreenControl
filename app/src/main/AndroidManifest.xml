<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ubah timeout layar sistem -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Overlay hitam (screen-off palsu) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Notifikasi timer (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Service timer & overlay -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Alarm backstop saat HP tidur (doze) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Pasang ulang alarm jadwal setelah reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Daftar aplikasi launchable untuk fitur timeout per aplikasi
         (tanpa QUERY_ALL_PACKAGES) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ZScreenApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZScreenControl">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Layanan aksesibilitas: kunci layar (GLOBAL_ACTION_LOCK_SCREEN)
             + deteksi app foreground untuk per-app timeout. -->
        <service
            android:name=".service.ScreenOffAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Device Admin: hanya untuk force-lock (lockNow). -->
        <receiver
            android:name=".deviceadmin.ScreenOffDeviceAdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Sleep timer (foreground service) -->
        <service
            android:name=".service.SleepTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="sleep_timer" />
        </service>

        <receiver
            android:name=".service.SleepTimerAlarmReceiver"
            android:exported="false" />

        <!-- Overlay hitam penuh (screen-off palsu) -->
        <service
            android:name=".service.BlackOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="black_overlay" />
        </service>

        <!-- Quick Settings Tile: matikan layar langsung -->
        <service
            android:name=".tile.ScreenOffTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_screen_off"
            android:label="@string/tile_screen_off_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: sleep timer mulai/berhenti -->
        <service
            android:name=".tile.SleepTimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_sleep"
            android:label="@string/tile_sleep_timer_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Scheduler: eksekusi jadwal + pasang ulang setelah reboot -->
        <receiver
            android:name=".scheduler.ScheduleAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".scheduler.ScheduleBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Widget: Matikan Layar -->
        <receiver
            android:name=".widget.ScreenOffWidgetProvider"
            android:exported="true"
            android:label="@string/widget_screen_off_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/screen_off_widget_info" />
        </receiver>

        <!-- Widget: Sleep Timer -->
        <receiver
            android:name=".widget.SleepTimerWidgetProvider"
            android:exported="true"
            android:label="@string/tile_sleep_timer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sleep_timer_widget_info" />
        </receiver>
    </application>
</manifest>
